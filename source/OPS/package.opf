    <dc:title id="t1">The Book of Disquiet</dc:title>
    <dc:creator id="id">Fernando Pessoa</dc:creator>
    <dc:identifier>isbn:9781878972279</dc:identifier>
    <dc:identifier>google:jj-BPwAACAAJ</dc:identifier>
